{
  "name": "webtdm",
  "version": "1.0.0",
  "description": "Local Network 3D PUBG-style Team Deathmatch & Free-For-All in Three.js",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node -e \"import('node:fs').then(fs=>{fs.mkdirSync('public/vendor',{recursive:true});fs.copyFileSync('node_modules/three/build/three.module.js','public/vendor/three.module.js');fs.copyFileSync('node_modules/three/build/three.core.js','public/vendor/three.core.js');})\"",
    "test": "node test.js"
  },
  "dependencies": {
    "three": "^0.174.0",
    "ws": "^8.18.1"
  }
}
